<Window x:Class="Lyricify.Backgrounds.Demo.Wpf.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 Title="Lyricify Backgrounds Demo · WPF"
                 Width="1400" Height="900" MinWidth="700" MinHeight="680"
                 WindowStartupLocation="CenterScreen"
                 Background="{DynamicResource ApplicationBackgroundBrush}"
                 Foreground="{DynamicResource TextFillColorPrimaryBrush}">
    <Window.Resources>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
            <Setter Property="Margin" Value="0,20,0,10" />
        </Style>
        <Style x:Key="ParameterLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ParameterValue" TargetType="TextBlock">
            <Setter Property="Width" Value="54" />
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="16" />
            <ColumnDefinition Width="390" />
        </Grid.ColumnDefinitions>

        <Border CornerRadius="16" Background="Black" ClipToBounds="True"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <Grid x:Name="PreviewHost" ClipToBounds="True">
                <Grid.Clip>
                    <RectangleGeometry x:Name="PreviewClip" RadiusX="15" RadiusY="15" />
                </Grid.Clip>
            </Grid>
        </Border>

        <Border Grid.Column="2" CornerRadius="16" Padding="24,20"
                Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="Background lab" FontSize="26" FontWeight="SemiBold" />
                    <TextBlock Text="Preview and tune the Apple Music inspired renderer."
                               Margin="0,4,0,16" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                    <TextBlock Text="ARTWORK" Style="{StaticResource SectionTitle}" Margin="0,0,0,10" />
                    <TextBox Text="{Binding ArtworkUrl, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Paste an image URL" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                        <Button Content="Load URL" Click="LoadUrl_Click" HorizontalAlignment="Stretch" />
                        <Button Grid.Column="2" Content="Open file" Click="OpenFile_Click" HorizontalAlignment="Stretch" />
                    </Grid>

                    <TextBlock Text="PLAYBACK &amp; LAYOUT" Style="{StaticResource SectionTitle}" />
                    <ComboBox ItemsSource="{Binding PresetOptions}" SelectedIndex="{Binding SelectedPresetIndex}"
                              Margin="0,0,0,12" ToolTip="Choose one of the five original preset slots." />
                    <WrapPanel>
                        <CheckBox Content="Playing" IsChecked="{Binding IsPlaying}" Margin="0,0,18,8" />
                        <CheckBox Content="Vertical layout" IsChecked="{Binding IsVertical}" Margin="0,0,18,8" />
                        <CheckBox Content="Light theme" IsChecked="{Binding IsLightTheme}" Margin="0,0,18,8" />
                        <CheckBox Content="Lyrics mode" IsChecked="{Binding IsBehindLyrics}" Margin="0,0,0,8"
                                  ToolTip="Use the background treatment shown while lyrics are displayed." />
                    </WrapPanel>

                    <TextBlock Text="RENDERING" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="125"/><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Frame rate" Style="{StaticResource ParameterLabel}" />
                        <Slider Grid.Column="1" Minimum="-1" Maximum="120" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FrameRateLimit}" />
                        <TextBlock Grid.Column="2" Text="{Binding FrameRateLimit}" Style="{StaticResource ParameterValue}" />
                        <TextBlock Grid.Row="2" Text="Render scale" Style="{StaticResource ParameterLabel}" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="0.125" Maximum="1" TickFrequency="0.025" Value="{Binding RenderScale}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding RenderScale, StringFormat={}{0:0.000}}" Style="{StaticResource ParameterValue}" />
                        <TextBlock Grid.Row="4" Text="Rotation scale" Style="{StaticResource ParameterLabel}" />
                        <Slider Grid.Row="4" Grid.Column="1" Minimum="0" Maximum="10" TickFrequency="0.1" Value="{Binding RotationScale}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding RotationScale, StringFormat={}{0:0.00}}" Style="{StaticResource ParameterValue}" />
                        <TextBlock Grid.Row="6" Text="Bass pulse" Style="{StaticResource ParameterLabel}" />
                        <Slider Grid.Row="6" Grid.Column="1" Minimum="0" Maximum="10" TickFrequency="0.1" Value="{Binding BassPulseScale}" />
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding BassPulseScale, StringFormat={}{0:0.00}}" Style="{StaticResource ParameterValue}" />
                        <TextBlock Grid.Row="8" Text="Blur scale" Style="{StaticResource ParameterLabel}" />
                        <Slider Grid.Row="8" Grid.Column="1" Minimum="0" Maximum="10" TickFrequency="0.1" Value="{Binding BlurScale}" />
                        <TextBlock Grid.Row="8" Grid.Column="2" Text="{Binding BlurScale, StringFormat={}{0:0.00}}" Style="{StaticResource ParameterValue}" />
                    </Grid>

                    <TextBlock Text="MESH" Style="{StaticResource SectionTitle}" />
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/><RowDefinition Height="8"/><RowDefinition/></Grid.RowDefinitions>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="148"/><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                        <TextBlock Text="Portrait points" Style="{StaticResource ParameterLabel}" />
                        <Slider Grid.Column="1" Minimum="-1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PortraitControlPointCount}" />
                        <TextBlock Grid.Column="2" Text="{Binding PortraitControlPointCount}" Style="{StaticResource ParameterValue}" />
                        <TextBlock Grid.Row="2" Text="Portrait subdivisions" Style="{StaticResource ParameterLabel}" />
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="-1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding PortraitSubdivisionLevels}" />
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding PortraitSubdivisionLevels}" Style="{StaticResource ParameterValue}" />
                        <TextBlock Grid.Row="4" Text="Landscape points" Style="{StaticResource ParameterLabel}" />
                        <Slider Grid.Row="4" Grid.Column="1" Minimum="-1" Maximum="16" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding LandscapeControlPointCount}" />
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding LandscapeControlPointCount}" Style="{StaticResource ParameterValue}" />
                        <TextBlock Grid.Row="6" Text="Landscape subdivisions" Style="{StaticResource ParameterLabel}" />
                        <Slider Grid.Row="6" Grid.Column="1" Minimum="-1" Maximum="4" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding LandscapeSubdivisionLevels}" />
                        <TextBlock Grid.Row="6" Grid.Column="2" Text="{Binding LandscapeSubdivisionLevels}" Style="{StaticResource ParameterValue}" />
                    </Grid>

                    <Button Content="Reset defaults" Click="Reset_Click" Margin="0,22,0,10" HorizontalAlignment="Stretch" />
                    <TextBlock Text="{Binding Status}" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
