<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0-windows10.0.17763.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SuppressTfmSupportBuildWarnings>true</SuppressTfmSupportBuildWarnings>
    <IsPackable>true</IsPackable>
    <PackageId>Lyricify.Backgrounds.AppleMusicInspired.Windows</PackageId>
    <Description>Windows artwork decoding and WASAPI spectrum analysis for the Lyricify Apple Music inspired background.</Description>
    <Authors>XY Wang</Authors>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Lyricify.Backgrounds.AppleMusicInspired\Lyricify.Backgrounds.AppleMusicInspired.csproj" />
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="6.0.0" />
  </ItemGroup>
</Project>
