<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>true</IsPackable>
    <PackageId>Lyricify.Backgrounds.AppleMusicInspired.IosClassic.Shared</PackageId>
    <Description>Framework-independent rendering data and shader resources for Apple Music Inspired · iOS Classic.</Description>
    <Authors>XY Wang</Authors>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\AppleMusicIosClassicBackground.hlsl"
                      LogicalName="Lyricify.Backgrounds.AppleMusicInspired.IosClassic.Shared.Resources.AppleMusicIosClassicBackground.hlsl" />
  </ItemGroup>
</Project>
